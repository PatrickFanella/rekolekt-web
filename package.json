{
  "name": "@subcult/rekolekt-web",
  "version": "0.1.0",
  "description": "Headless frontend kit for Rekolekt archives: typed API client, React hooks and stylable default components. No pages.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.subcult.tv/subculture-collective/rekolekt-web.git"
  },
  "publishConfig": {
    "registry": "https://git.subcult.tv/api/packages/subculture-collective/npm/"
  },
  "files": [
    "dist",
    "openapi/openapi.json",
    "openapi/core-revision.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atproto": {
      "types": "./dist/atproto.d.ts",
      "import": "./dist/atproto.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js"
    },
    "./base.css": "./dist/base.css",
    "./openapi.json": "./openapi/openapi.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "rekolekt-web-metadata": "./dist/metadata/cli.js"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json --output src/types/generated/api.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pack:check": "node scripts/check-pack.mjs",
    "example": "vite --config examples/vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@atproto/oauth-client-browser": ">=0.5.7 <0.6",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@atproto/oauth-client-browser": {
      "optional": true
    }
  },
  "dependencies": {
    "ky": "^1.11.0"
  },
  "devDependencies": {
    "@atproto/oauth-client-browser": "0.5.7",
    "@eslint/js": "^9.36.0",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.11.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "happy-dom": "20.10.6",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "tar": "7.5.21"
  },
  "engines": {
    "node": ">=20"
  }
}
